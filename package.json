{
  "name": "delibero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deliberation Process Design Tool — guided questionnaire that recommends deliberative process designs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
