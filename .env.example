# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Browser (bundled into the client, safe to expose) ----------------------
# These end up in the JavaScript bundle. That is fine and expected: Appwrite
# security comes from table permissions and the project's allowed platforms,
# not from hiding the project id.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=delibero

# --- Server-side scripts only (NEVER expose to the browser) -----------------
# Used by `npm run appwrite:setup` and `npm run appwrite:seed`.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=delibero
# Server API key from the Appwrite console. Full admin rights — keep it secret
# and local. The deployed site never needs it.
APPWRITE_API_KEY=
